# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Jogira

# MongoDB
MONGODB_URI=mongodb://localhost:27017/jogira

# JWT (Admin Auth)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Admin seed (used by npm run seed)
ADMIN_EMAIL=admin@jogira.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# GST rate (percentage)
GST_RATE=18

# Coupon (optional default)
DEFAULT_COUPON_CODE=WELCOME10
DEFAULT_COUPON_DISCOUNT=10
